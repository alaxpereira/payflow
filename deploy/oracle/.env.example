# Copie para /opt/payflow/.env e preencha. Esse arquivo nunca vai para o Git.

# IP público da VM + sslip.io: resolve para o próprio IP sem precisar comprar um domínio.
# Ex.: 129.146.10.20.sslip.io
DOMAIN=

# E-mail para a Let's Encrypt avisar sobre certificados.
ACME_EMAIL=

# Gere cada senha com: openssl rand -hex 24
# (só letras e números: elas entram em URLs de conexão)
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Requisições por minuto por IP na API pública.
API_RATE_LIMIT_PER_MINUTE=120
